rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read so the Status page works for logged-out visitors.
    // No client writes — only the Admin SDK (server route, bypasses rules)
    // is allowed to write health-check records.
    match /healthChecks/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Internal ping doc used by the health-check job. No client access needed.
    match /_health/{docId} {
      allow read, write: if false;
    }

    // Each user can read/write only their own profile doc (username, avatar, plan).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Obfuscation job records. Written only by the Admin SDK from
    // /api/jobs (bypasses these rules), never directly by the client.
    // A signed-in user may only read rows that belong to them.
    match /jobs/{jobId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // --- your existing rules for projects/etc. go below ---
  }
}
