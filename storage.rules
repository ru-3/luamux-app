rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Each signed-in user may read/write only their own avatar file(s).
    // Written from the Settings page ("Upload new avatar").
    match /avatars/{uid}/{fileName} {
      allow read: if true; // avatars are shown publicly (sidebar, etc.)
      allow write: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 4 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
